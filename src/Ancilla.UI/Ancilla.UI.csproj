<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Every page, component and service of the app, shared by its two hosts: the desktop shell
    (src/Ancilla.App, .NET MAUI Blazor Hybrid) and the web dev host (src/Ancilla.Web), which the
    browser tests use. Packages only, no ASP.NET shared framework, so the MAUI head can reference it,
    and it builds and tests on Linux.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ancilla.Core\Ancilla.Core.csproj" />
    <ProjectReference Include="..\Ancilla.Theater\Ancilla.Theater.csproj" />
    <ProjectReference Include="..\Ancilla.Data\Ancilla.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15" />
  </ItemGroup>

</Project>
