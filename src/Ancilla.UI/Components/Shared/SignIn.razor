@inject HaloSession Session

@* Pages set their own titles, but signed out they aren't rendered, so this is the only one. *@
<PageTitle>Sign in · Ancilla</PageTitle>

<section class="card signin">
    <h1>Sign in</h1>
    <form @onsubmit="SubmitAsync" @onsubmit:preventDefault>
        <label for="token">Spartan token</label>
        <input id="token" type="password" autocomplete="off" spellcheck="false"
               placeholder="Paste the 343-spartan-token cookie value" @bind="_token" @bind:event="oninput" />
        <p class="hint">
            Sign in at halowaypoint.com, then DevTools &rsaquo; Application &rsaquo; Cookies &rsaquo;
            <code>343-spartan-token</code>. Tokens last a few hours and are only held in the app's memory
            until you sign out or close it. Or set <code>HALO_SPARTAN_TOKEN</code> before starting the app.
        </p>
        <button type="submit" disabled="@(_busy || string.IsNullOrWhiteSpace(_token))">
            @(_busy ? "Checking…" : "Sign in")
        </button>
    </form>
    @if ((_error ?? InitialError) is { } err)
    {
        <p class="error" role="alert">@err</p>
    }
</section>

@code {
    [Parameter] public string? InitialError { get; set; }

    private string? _token;
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_token)) return;
        _busy = true;
        _error = null;
        try
        {
            await Session.SignInAsync(_token);
        }
        catch (Exception ex)
        {
            _error = Explain(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    public static string Explain(Exception ex) =>
        ex is HttpRequestException { StatusCode: System.Net.HttpStatusCode.Unauthorized }
            ? "Halo Waypoint rejected the token. It has probably expired; grab a fresh one."
            : ex.Message;
}
