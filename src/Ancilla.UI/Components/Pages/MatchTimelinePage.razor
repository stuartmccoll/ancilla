@page "/matches/{MatchId}/timeline"
@using Ancilla.Theater
@inject HaloSession Session
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Timeline · @(_mode?.PublicName ?? "Match") · Ancilla</PageTitle>

<p class="back"><a href="@($"matches/{MatchId}")">&larr; Match</a></p>

<h1>Match timeline</h1>
@if (_match is { } m)
{
    <p class="muted">@(_mode?.PublicName ?? "Match") · @(_map?.PublicName ?? "Unknown map") · @Fmt.When(m.MatchInfo.StartTime)</p>
}

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
    @if (_canRetry) { <button @onclick="LoadAsync">Try again</button> }
}
else if (_timeline is null)
{
    <section class="card intro">
        <p>
            The timeline comes from the match's Theater film: who killed whom and when, the medals each kill
            earned, and where players died. The film is downloaded once (usually 9–30 MB) and kept in
            <code>@Session.FilmFolder</code> on this computer.
        </p>
        @if (_loading)
        {
            <p role="status" aria-live="polite">@(_total == 0 ? "Getting the film…" : _done < _total ? $"Downloading the film: {_done} of {_total} parts…" : "Reading the film…")</p>
            @if (_total > 0) { <progress max="@_total" value="@_done"></progress> }
        }
        else
        {
            <button @onclick="LoadAsync">Load the timeline</button>
        }
    </section>
}
else
{
    var t = _timeline;
    <p class="note">
        Times are into the match. @if (t.BotsAndUnlinked > 0) { <span>Bots and players who joined with no recorded events aren't in the film, so kills of them show as "a bot or another player". </span> }
        <a href="about#timeline">How the timeline is worked out</a>.
    </p>

    <h2 class="section-title">Team kills by minute</h2>
    <section class="card">
        @{
            var max = Math.Max(1, t.TeamKillsPerMinute.Max(m => m.DefaultIfEmpty().Max()));
            var n = t.TeamKillsPerMinute.Count;
            const int H = 140, GroupW = 24;
        }
        <svg class="minutes" viewBox="0 0 @(n * GroupW) @(H + 16)" role="img" aria-label="Kills per minute for each team. The table below has the same figures.">
            @for (var i = 0; i < n; i++)
            {
                for (var k = 0; k < t.Teams.Count && k < 2; k++)
                {
                    var v = t.TeamKillsPerMinute[i][k];
                    var h = v * (double)H / max;
                    <rect class="@($"team{k}")" x="@Fmt.Css(i * GroupW + 3 + k * 9)" y="@Fmt.Css(H - h)" width="8" height="@Fmt.Css(h)" rx="2">
                        <title>Minute @(i + 1): @Fmt.TeamName(t.Teams[k]) @v</title>
                    </rect>
                }
                // Razor reserves <text>, so the SVG label is written as markup.
                if (i % 2 == 0) { @((MarkupString)$"<text x=\"{Fmt.Css(i * GroupW + GroupW / 2.0)}\" y=\"{H + 13}\" text-anchor=\"middle\">{i + 1}</text>") }
            }
        </svg>
        <p class="legend">
            @for (var k = 0; k < t.Teams.Count && k < 2; k++) { <span class="key @($"team{k}")"></span> @Fmt.TeamName(t.Teams[k]) }
            <span class="muted">· minute of the match</span>
        </p>
        <details class="table-view">
            <summary>Show as table</summary>
            <table>
                <thead><tr><th class="l">Minute</th>@foreach (var team in t.Teams) { <th>@Fmt.TeamName(team)</th> }</tr></thead>
                <tbody>
                    @for (var i = 0; i < n; i++)
                    {
                        <tr><td class="l">@(i + 1)</td>@foreach (var v in t.TeamKillsPerMinute[i]) { <td>@v</td> }</tr>
                    }
                </tbody>
            </table>
        </details>
    </section>

    @if (t.HasPositions)
    {
        <h2 class="section-title">Map</h2>
        <section class="card">
            <div class="controls">
                <label class="filter">Show
                    <select @bind="_layer" @bind:after="Unpin">
                        <option value="@Layer.Deaths">where players died</option>
                        <option value="@Layer.Kills">kills, from killer to victim</option>
                        <option value="@Layer.Time">where players spent time</option>
                        @if (t.Objectives.Count > 0) { <option value="@Layer.Objectives">objective events</option> }
                        @if (t.Playback is not null) { <option value="@Layer.Movement">movement, animated</option> }
                    </select>
                </label>
                <label class="filter">@(_layer switch { Layer.Deaths => "of", Layer.Time or Layer.Movement => "for", _ => "by" })
                    <select @bind="_mapFocus" @bind:after="Unpin">
                        <option value="-1">everyone</option>
                        @for (var k = 0; k < t.Teams.Count; k++) { <option value="@(TeamFocus + k)">@Fmt.TeamName(t.Teams[k]) team</option> }
                        @foreach (var p in t.Players) { <option value="@p.Index">@Name(p.Index)</option> }
                    </select>
                </label>
            </div>
            @switch (_layer)
            {
                case Layer.Deaths:
                    var died = t.Deaths.Select((d, i) => (d, i)).Where(x => InFocus(x.d.Player)).ToList();
                    <div class="map-stack">
                        <svg class="@($"map{(_hot is { } dh && dh.Layer == Layer.Deaths ? " has-hot" : "")}")" viewBox="0 0 @MatchTimeline.MapWidth @MatchTimeline.MapHeight" role="group" @onclick="Unpin"
                             aria-label="@($"Map of the arena with {died.Count} deaths, coloured by the team of the player who died, each with a line showing which way they faced. Hover over or select a death for details; the table below lists them.")">
                            @Ground(t)
                            @foreach (var (d, i) in died)
                            {
                                var team = TeamIndex(d.Team);
                                <g class="@Mark(Layer.Deaths, i)" tabindex="0" role="button" aria-label="@DeathSummary(t, d)"
                                   @onmouseenter="() => Hot(Layer.Deaths, i)" @onmouseleave="Cold" @onfocus="() => Hot(Layer.Deaths, i)" @onblur="Cold" @onclick="() => Toggle(Layer.Deaths, i)" @onclick:stopPropagation="true">
                                    @Facing(d.At, d.Facing, team)
                                    <circle class="@($"team{team}")" cx="@Fmt.Css(d.At.X)" cy="@Fmt.Css(d.At.Y)" r="1.3" />
                                </g>
                            }
                        </svg>
                        @if (_hot is { Layer: Layer.Deaths } hd) { @TipCard(t, t.Deaths[hd.Index], asKill: false) }
                    </div>
                    <p class="legend">
                        @for (var k = 0; k < t.Teams.Count && k < 2; k++) { <span class="key @($"team{k}")"></span> @($"{Fmt.TeamName(t.Teams[k])} player died") }
                        <span class="muted">· the line shows which way they were facing. @MapNote @FloorNote(t)</span>
                    </p>
                    <details class="table-view">
                        <summary>Show as table</summary>
                        <table>
                            <thead><tr><th class="l">Time</th><th class="l">Player</th><th class="l">Killed by</th><th>Across</th><th>Down</th><th title="0° is looking straight at the killer, 180° is facing away">Facing away from killer</th></tr></thead>
                            <tbody>
                                @foreach (var (d, _) in died)
                                {
                                    <tr><td class="l">@Fmt.Clock(d.TimeMs)</td><td class="l">@Name(d.Player)</td><td class="l">@(d.Killer is { } k ? Name(k) : "—")</td>
                                        <td>@Across(d.At)</td><td>@Down(d.At)</td><td>@Degrees(d.AngleOff)</td></tr>
                                }
                            </tbody>
                        </table>
                    </details>
                    break;

                case Layer.Kills:
                    var kills = t.Deaths.Select((d, i) => (d, i)).Where(x => x.d.Killer is { } k && x.d.KillerAt is not null && InFocus(k)).ToList();
                    <div class="map-stack">
                        <svg class="@($"map{(_hot is { } kh && kh.Layer == Layer.Kills ? " has-hot" : "")}")" viewBox="0 0 @MatchTimeline.MapWidth @MatchTimeline.MapHeight" role="group" @onclick="Unpin"
                             aria-label="@($"Map of the arena with {kills.Count} kills, each a line from the killer to the victim, coloured by the killer's team. Hover over or select a kill for details; the table below lists them.")">
                            @Ground(t)
                            @foreach (var (d, i) in kills)
                            {
                                var team = TeamIndex(t.Players[d.Killer!.Value].Team);
                                var from = d.KillerAt!.Value;
                                <g class="@Mark(Layer.Kills, i)" tabindex="0" role="button" aria-label="@DeathSummary(t, d)"
                                   @onmouseenter="() => Hot(Layer.Kills, i)" @onmouseleave="Cold" @onfocus="() => Hot(Layer.Kills, i)" @onblur="Cold" @onclick="() => Toggle(Layer.Kills, i)" @onclick:stopPropagation="true">
                                    <line class="hit" x1="@Fmt.Css(from.X)" y1="@Fmt.Css(from.Y)" x2="@Fmt.Css(d.At.X)" y2="@Fmt.Css(d.At.Y)" />
                                    <line class="@($"shot stroke{team}")" x1="@Fmt.Css(from.X)" y1="@Fmt.Css(from.Y)" x2="@Fmt.Css(d.At.X)" y2="@Fmt.Css(d.At.Y)" />
                                    @Facing(from, d.KillerFacing, team)
                                    <circle class="@($"team{team}")" cx="@Fmt.Css(from.X)" cy="@Fmt.Css(from.Y)" r="1.1" />
                                    <circle class="@($"victim stroke{team}")" cx="@Fmt.Css(d.At.X)" cy="@Fmt.Css(d.At.Y)" r=".9" />
                                </g>
                            }
                        </svg>
                        @if (_hot is { Layer: Layer.Kills } hk) { @TipCard(t, t.Deaths[hk.Index], asKill: true) }
                    </div>
                    <p class="legend">
                        @for (var k = 0; k < t.Teams.Count && k < 2; k++) { <span class="key @($"team{k}")"></span> @($"{Fmt.TeamName(t.Teams[k])} killer") }
                        <span class="key ring"></span> victim
                        <span class="muted">· the short line shows which way the killer was facing. Kills where the killer's position isn't known are left out. @MapNote @FloorNote(t)</span>
                    </p>
                    <details class="table-view">
                        <summary>Show as table</summary>
                        <table>
                            <thead><tr><th class="l">Time</th><th class="l">Killer</th><th class="l">Victim</th><th>Killer across</th><th>Killer down</th><th>Victim across</th><th>Victim down</th><th title="0° is looking straight at the killer, 180° is facing away">Victim facing away</th></tr></thead>
                            <tbody>
                                @foreach (var (d, _) in kills)
                                {
                                    <tr><td class="l">@Fmt.Clock(d.TimeMs)</td><td class="l">@Name(d.Killer!.Value)</td><td class="l">@Name(d.Player)</td>
                                        <td>@Across(d.KillerAt!.Value)</td><td>@Down(d.KillerAt.Value)</td><td>@Across(d.At)</td><td>@Down(d.At)</td><td>@Degrees(d.AngleOff)</td></tr>
                                }
                            </tbody>
                        </table>
                    </details>
                    break;

                case Layer.Time:
                    var grid = FocusTime(t);
                    var heat = MatchTimeline.HeatLevels(grid, HeatSteps);
                    var linked = t.Summaries.Where(s => InFocus(s.Player)).Sum(s => s.LivesPlaced);
                    var spawns = t.Summaries.Where(s => InFocus(s.Player)).Sum(s => s.Deaths + 1);
                    <svg class="map" viewBox="0 0 @MatchTimeline.MapWidth @MatchTimeline.MapHeight" role="img"
                         aria-label="Heatmap of the arena: blue where little time was spent, red where the most was. The table below gives the time in each part of the map.">
                        @Ground(t)
                        @if (t.Floor.Count > 0) { @FloorClip(t) }
                        <g class="heat" clip-path="@(t.Floor.Count > 0 ? "url(#timeline-floor)" : null)">
                            @foreach (var (x, y) in t.Arena)
                            {
                                var level = heat[y * MatchTimeline.MapWidth + x];
                                if (level > 0) { <rect class="@($"heat{level}")" x="@x" y="@y" width="1" height="1" /> }
                            }
                        </g>
                    </svg>
                    <p class="legend">
                        less time @for (var l = 1; l <= HeatSteps; l++) { <span class="swatch @($"heat{l}")"></span> } more time
                        <span class="muted">· each colour covers the same number of squares. Counts @linked of about @spawns lives: lives the film couldn't link to a player are left out. @MapNote @FloorNote(t)</span>
                    </p>
                    <details class="table-view">
                        <summary>Show as table</summary>
                        @{ var total = Math.Max(1, grid.Sum()); var zones = Zones(grid); }
                        <table>
                            <thead><tr><th class="l">Part of the map</th><th class="l">Left</th><th class="l">Middle</th><th class="l">Right</th></tr></thead>
                            <tbody>
                                @for (var r = 0; r < 3; r++)
                                {
                                    <tr><td class="l">@(new[] { "Top", "Middle", "Bottom" }[r])</td>
                                        @for (var c = 0; c < 3; c++) { <td class="l">@Fmt.Pct(100.0 * zones[r, c] / total, 0)</td> }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </details>
                    break;

                case Layer.Movement when t.Playback is { } pb:
                    <div class="playback" @ref="_playbackRoot">
                        <div class="map-stack">
                            <svg class="map" viewBox="0 0 @MatchTimeline.MapWidth @MatchTimeline.MapHeight" role="img"
                                 aria-label="Animated map of where each player moved, coloured by team. Use the controls below to play it; the table below gives positions every 30 seconds.">
                                @Ground(t)
                            </svg>
                            <svg class="overlay" viewBox="0 0 @MatchTimeline.MapWidth @MatchTimeline.MapHeight" aria-hidden="true"></svg>
                        </div>
                        <div class="player-controls">
                            <button type="button" class="play" aria-pressed="false">Play</button>
                            <input type="range" class="scrub" min="0" max="@t.DurationMs" step="@MatchTimeline.PlaybackStepMs" value="0" aria-label="Time in the match" />
                            <span class="clock"></span>
                            <label class="filter">Speed
                                <select class="speed">
                                    <option value="1">1×</option><option value="2">2×</option><option value="4" selected>4×</option><option value="8">8×</option><option value="16">16×</option>
                                </select>
                            </label>
                        </div>
                        <ul class="roster" aria-label="Each player's state at the time shown">
                            @foreach (var tr in pb.Tracks)
                            {
                                <li data-player="@tr.Player"><span class="key @TeamClass(tr.Player)"></span>@Name(tr.Player) <span class="state"></span></li>
                            }
                        </ul>
                    </div>
                    <p class="legend">
                        @for (var k = 0; k < t.Teams.Count && k < 2; k++) { <span class="key @($"team{k}")"></span> @Fmt.TeamName(t.Teams[k]) }
                        <span class="muted">· each dot is a player, with the way they're facing and a trail of the last 3 seconds. Kills flash as a cross where the victim died. The list under the controls says who's alive, dead or not in the match at each moment, including players alive somewhere the film couldn't place them. @MapNote @FloorNote(t)</span>
                    </p>
                    <details class="table-view">
                        <summary>Show as table</summary>
                        <div class="scroll">
                            <table>
                                <thead><tr><th class="l">Time</th>@foreach (var tr in pb.Tracks.Where(x => InFocus(x.Player))) { <th class="l">@Name(tr.Player)</th> }</tr></thead>
                                <tbody>
                                    @for (var f = 0; f < pb.Frames; f += 30_000 / pb.StepMs)
                                    {
                                        <tr><td class="l">@Fmt.Clock((uint)(f * pb.StepMs))</td>
                                            @foreach (var tr in pb.Tracks.Where(x => InFocus(x.Player)))
                                            {
                                                <td class="l">@(tr.X10[f] >= 0 ? $"{Fmt.Pct(tr.X10[f] / 10.0 * 100 / MatchTimeline.MapWidth, 0)} across, {Fmt.Pct(tr.Y10[f] / 10.0 * 100 / MatchTimeline.MapHeight, 0)} down" : StateText(tr.Alive[f]))</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </details>
                    break;

                case Layer.Objectives:
                    var objectives = t.Objectives.Where(o => InFocus(o.Player)).ToList();
                    <svg class="map" viewBox="0 0 @MatchTimeline.MapWidth @MatchTimeline.MapHeight" role="img"
                         aria-label="@($"Map of the arena with {objectives.Count} objective events, coloured by the player's team. The table below lists them.")">
                        @Ground(t)
                        @foreach (var o in objectives)
                        {
                            <rect class="@($"objective team{TeamIndex(o.Team)}")" x="@Fmt.Css(o.At.X - 1)" y="@Fmt.Css(o.At.Y - 1)" width="2" height="2"
                                  transform="@($"rotate(45 {Fmt.Css(o.At.X)} {Fmt.Css(o.At.Y)})")">
                                <title>@Fmt.Clock(o.TimeMs) @Name(o.Player)</title>
                            </rect>
                        }
                    </svg>
                    <p class="legend">
                        @for (var k = 0; k < t.Teams.Count && k < 2; k++) { <span class="key diamond @($"team{k}")"></span> @Fmt.TeamName(t.Teams[k]) }
                        <span class="muted">· where the player was at each objective event (in Capture the Flag, a flag action; the film doesn't say which). @MapNote @FloorNote(t)</span>
                    </p>
                    <details class="table-view">
                        <summary>Show as table</summary>
                        <table>
                            <thead><tr><th class="l">Time</th><th class="l">Player</th><th>Across</th><th>Down</th></tr></thead>
                            <tbody>
                                @foreach (var o in objectives)
                                {
                                    <tr><td class="l">@Fmt.Clock(o.TimeMs)</td><td class="l">@Name(o.Player)</td><td>@Across(o.At)</td><td>@Down(o.At)</td></tr>
                                }
                            </tbody>
                        </table>
                    </details>
                    break;
            }
        </section>
    }

    <h2 class="section-title">Players</h2>
    <section class="card scroll">
        <table>
            <thead>
                <tr>
                    <th class="l">Player</th><th>Kills</th><th>Deaths</th><th title="Most kills in one life">Best streak</th>
                    <th title="Kills after which the player died within 3 seconds">Traded</th><th title="Kills of the player who last killed them">Revenge</th>
                    <th class="l" title="The opponent who killed them most">Nemesis</th><th title="Flag actions in Capture the Flag; objective awards in Firefight">Objectives</th>
                    @if (t.HasPositions) { <th title="Median distance from the player to the victim, in film units">Kill distance</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var s in t.Summaries.OrderBy(s => t.Players[s.Player].Team).ThenByDescending(s => s.Kills))
                {
                    <tr class="@(t.Players[s.Player].Xuid == Session.Xuid ? "me" : "")">
                        <td class="l"><span class="key @TeamClass(s.Player)"></span>@Name(s.Player)@(t.Players[s.Player].LateJoiner ? " (joined late)" : "")</td>
                        <td>@s.Kills</td><td>@s.Deaths</td><td>@s.LongestStreak</td><td>@s.Traded</td><td>@s.Revenge</td>
                        <td class="l">@(s.Nemesis is { } ne ? Name(ne) : "—")</td><td>@s.Objectives</td>
                        @if (t.HasPositions) { <td>@(s.KillDistance is { } kd ? kd.ToString("N0") : "—")</td> }
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <h2 class="section-title">Kill feed</h2>
    <section class="card">
        <label class="filter">Show
            <select @bind="_feedPlayer">
                <option value="-1">everyone</option>
                @foreach (var p in t.Players) { <option value="@p.Index">@Name(p.Index)</option> }
            </select>
        </label>
        <table class="feed">
            <thead><tr><th class="l">Time</th><th class="l">What happened</th><th class="l">Medals</th></tr></thead>
            <tbody>
                @foreach (var f in t.Feed.Where(f => (_feedPlayer < 0 || f.Player == _feedPlayer || f.Other == _feedPlayer) && !(f.Kind == FeedKind.Medal && f.MedalNameIds.Count == 0)))
                {
                    <tr>
                        <td class="l">@Fmt.Clock(f.TimeMs)</td>
                        <td class="l">
                            <span class="key @TeamClass(f.Player)"></span>@Name(f.Player)
                            @switch (f.Kind)
                            {
                                case FeedKind.Kill: <span> killed </span>@if (f.Other is { } v) { <span class="key @TeamClass(v)"></span>@Name(v) } else { <span>a bot or another player</span> } break;
                                case FeedKind.Death: <span class="muted"> died (no killer recorded: a suicide, or killed by a bot)</span> break;
                                case FeedKind.Medal: <span class="muted"> earned a medal</span> break;
                                case FeedKind.Objective: <span class="muted"> @FlagText(f.Flag)</span> break;
                                case FeedKind.Pickup: <span class="muted"> picked up a weapon</span> break;
                            }
                        </td>
                        <td class="l">@string.Join(", ", f.MedalNameIds.Select(MedalName))</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    [Parameter] public string MatchId { get; set; } = "";

    private MatchStats? _match;
    private UgcAsset? _map, _mode;
    private MatchTimeline? _timeline;
    private MedalBook? _book;
    private string? _error;
    private bool _canRetry, _loading;
    private int _done, _total, _mapFocus = -1, _feedPlayer = -1;
    private Layer _layer = Layer.Deaths;

    private enum Layer { Deaths, Kills, Time, Objectives, Movement }

    private static string FlagText(FlagAction? a) => a switch
    {
        FlagAction.Steal => "took the enemy flag from its base",
        FlagAction.Grab => "picked up the dropped enemy flag",
        FlagAction.Capture => "captured the flag",
        FlagAction.CaptureAssist => "assisted a flag capture",
        FlagAction.Drop => "dropped the flag",
        FlagAction.Return => "returned their flag",
        FlagAction.CarrierKill => "stopped the flag carrier",
        _ => "completed an objective",
    };

    // ---- Hover cards on the deaths and kills maps (Index is the death's position in Deaths) ----
    private (Layer Layer, int Index)? _hot;
    private bool _pinned;
    private void Hot(Layer layer, int index) { if (!_pinned) _hot = (layer, index); }
    private void Cold() { if (!_pinned) _hot = null; }
    private void Unpin() => (_hot, _pinned) = (null, false);
    // A tap or click keeps the card open (touch screens have no hover); another closes it.
    private void Toggle(Layer layer, int index)
    {
        if (_pinned && _hot == (layer, index)) (_hot, _pinned) = (null, false);
        else (_hot, _pinned) = ((layer, index), true);
    }
    private string Mark(Layer layer, int index) => _hot == (layer, index) ? "mark hot" : "mark";

    private string DeathSummary(MatchTimeline t, DeathPoint d) =>
        $"{Fmt.Clock(d.TimeMs)}: " + (d.Killer is { } k ? $"{Name(k)} killed {Name(d.Player)}" : $"{Name(d.Player)} died");

    // The kill-feed line for a death: the killer's kill 0–5 ms before it, with its medals.
    private static FeedEntry? KillOf(MatchTimeline t, DeathPoint d) =>
        d.Killer is { } k ? t.Feed.FirstOrDefault(f => f.Kind == FeedKind.Kill && f.Player == k && f.Other == d.Player && f.TimeMs <= d.TimeMs && d.TimeMs - f.TimeMs <= 5) : null;

    // Kills by the killer in their life so far, counting this one.
    private static int StreakAt(MatchTimeline t, FeedEntry kill)
    {
        var n = 0;
        foreach (var f in t.Feed)
        {
            if (f.TimeMs > kill.TimeMs) break;
            if (f.Kind == FeedKind.Kill && f.Player == kill.Player) n++;
            else if ((f.Kind == FeedKind.Kill && f.Other == kill.Player) || (f.Kind == FeedKind.Death && f.Player == kill.Player)) n = 0;
        }
        return n;
    }

    private static string Ordinal(int n) => n + (n % 100 is 11 or 12 or 13 ? "th" : (n % 10) switch { 1 => "st", 2 => "nd", 3 => "rd", _ => "th" });

    private RenderFragment TipCard(MatchTimeline t, DeathPoint d, bool asKill) => __builder =>
    {
        var at = asKill && d.KillerAt is { } ka ? new MapPoint((ka.X + d.At.X) / 2, (ka.Y + d.At.Y) / 2) : d.At;
        double x = 100 * at.X / MatchTimeline.MapWidth, y = 100 * at.Y / MatchTimeline.MapHeight;
        var side = (x < 18 ? " left" : x > 82 ? " right" : "") + (y < 30 ? " below" : "");
        var kill = KillOf(t, d);
        <div class="@($"tip{side}")" style="@($"left: {Fmt.Css(x)}%; top: {Fmt.Css(y)}%")" role="status">
            <div class="tip-time">@Fmt.Clock(d.TimeMs)</div>
            <div class="tip-title">
                @if (d.Killer is { } k)
                {
                    <span class="key @TeamClass(k)"></span>@Name(k) <span class="muted">killed</span> <span class="key @TeamClass(d.Player)"></span>@Name(d.Player)
                }
                else
                {
                    <span class="key @TeamClass(d.Player)"></span>@Name(d.Player) <span class="muted">died: no killer recorded (a suicide, or killed by a bot)</span>
                }
            </div>
            @if (kill is not null)
            {
                <div>@($"{Name(kill.Player)}'s {Ordinal(StreakAt(t, kill))} kill of that life")</div>
                @if (kill.MedalNameIds.Count > 0) { <div>Medals: @string.Join(", ", kill.MedalNameIds.Select(MedalName))</div> }
            }
            @if (d.AngleOff is { } a)
            {
                <div>@Name(d.Player) @(a < 45 ? "was facing the killer" : a > 135 ? "had their back to the killer" : "was side-on to the killer") (@Degrees(a) off)</div>
            }
        </div>
    };

    // The animation runs in the browser (MatchTimelinePage.razor.js); the page starts it when the
    // movement layer appears and tells it when the player filter changes.
    private ElementReference _playbackRoot;
    private IJSObjectReference? _module;
    private bool _playbackStarted;
    private int? _focusSent;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var showing = _layer == Layer.Movement && _timeline?.Playback is not null;
        if (!showing) { _playbackStarted = false; _focusSent = null; return; }
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./" + Assets["_content/Ancilla.UI/Components/Pages/MatchTimelinePage.razor.js"]);
            if (!_playbackStarted)
            {
                await _module.InvokeVoidAsync("start", _playbackRoot, PlaybackData(_timeline!));
                _playbackStarted = true;
            }
            if (_focusSent != _mapFocus)
            {
                await _module.InvokeVoidAsync("setFocus", _playbackRoot, _mapFocus < 0 ? null : _timeline!.Players.Where(p => InFocus(p.Index)).Select(p => p.Index).ToArray());
                _focusSent = _mapFocus;
            }
        }
        catch (JSDisconnectedException) { }
    }

    // What the movement table says for a moment with no position (the module uses the same words).
    private static string StateText(int alive) => alive switch
    {
        PlaybackTrack.IsAlive => "alive, position unknown",
        PlaybackTrack.IsDead => "dead",
        PlaybackTrack.NotInMatch => "not in the match",
        _ => "—",
    };

    private object PlaybackData(MatchTimeline t)
    {
        var pb = t.Playback!;
        int Team(int player) => TeamIndex(t.Players[player].Team);
        int Tenth(double v) => (int)Math.Round(v * 10);
        return new
        {
            stepMs = pb.StepMs,
            durationMs = t.DurationMs,
            players = pb.Tracks.Select(x => new { player = x.Player, team = Team(x.Player), name = Name(x.Player), x = x.X10, y = x.Y10, yaw = x.Yaw, alive = x.Alive }),
            kills = t.Deaths.Where(d => d.Killer is not null).Select(d => new
            {
                t = d.TimeMs, player = d.Killer!.Value, other = d.Player, team = Team(d.Killer.Value),
                kx = d.KillerAt is { } k ? Tenth(k.X) : -1, ky = d.KillerAt is { } k2 ? Tenth(k2.Y) : -1, vx = Tenth(d.At.X), vy = Tenth(d.At.Y),
            }),
            objectives = t.Objectives.Select(o => new { t = o.TimeMs, player = o.Player, other = -1, team = Team(o.Player), x = Tenth(o.At.X), y = Tenth(o.At.Y) }),
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
    private const int TeamFocus = 1000, HeatSteps = 6;
    private const string MapNote = "North may not be up.";

    // Under each map's legend: what the background is.
    private static string FloorNote(MatchTimeline t) => t.Floor.Count > 0
        ? "The floor is the map's own walkable area (from its Forge navmesh), darker where it's higher."
        : "Grey shows where players went.";

    protected override async Task OnParametersSetAsync()
    {
        _match = null; _timeline = null; _error = null; _canRetry = false; _loading = false;
        if (!HaloIds.IsGuid(MatchId)) { _error = "That isn't a valid match link."; return; }
        try
        {
            _match = await Session.GetMatchAsync(MatchId);
            (_map, _mode) = (await Session.GetMapAsync(_match.MatchInfo.MapVariant), await Session.GetModeAsync(_match.MatchInfo.UgcGameVariant));
            try { _book = await Session.GetMedalBookAsync(); } catch (HttpRequestException) { }
        }
        catch (Exception ex) { _error = SignIn.Explain(ex); return; }
        // A film already on disk needs no download, so show it straight away.
        if (Session.IsFilmCached(MatchId)) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null; _loading = true; _done = _total = 0;
        try
        {
            _timeline = await Session.GetTimelineAsync(MatchId, (done, total) => InvokeAsync(() => { (_done, _total) = (done, total); StateHasChanged(); }));
            // The map starts on the signed-in player when they're in the match.
            _mapFocus = _timeline.Players.FirstOrDefault(p => p.Xuid is not null && p.Xuid == Session.Xuid)?.Index ?? -1;
        }
        catch (UnfinishedFilmException)
        {
            _error = "This match didn't end normally, so its film has no end-of-match summary. The timeline is built from that summary, so it can't be shown for this match.";
        }
        catch (InvalidDataException)
        {
            _error = "This match's film couldn't be read. Films from older game versions, or matches with no film, aren't supported yet.";
        }
        catch (Exception ex)
        {
            _error = SignIn.Explain(ex);
            _canRetry = true;
        }
        finally { _loading = false; }
    }

    private string Name(int player) => _timeline?.Players[player].Gamertag ?? "";

    private string TeamClass(int player) =>
        _timeline is { } t ? $"team{Math.Max(0, t.Teams.ToList().IndexOf(t.Players[player].Team))}" : "";

    private string MedalName(long id) => _book?.ById.TryGetValue(id, out var d) == true && d.Name is { } n ? n : "a medal";

    private int TeamIndex(int team) => _timeline is { } t ? Math.Max(0, t.Teams.ToList().IndexOf(team)) : 0;

    // The map filter: everyone, one team (TeamFocus + its index) or one player.
    private bool InFocus(int player) =>
        _mapFocus < 0 || (_mapFocus >= TeamFocus
            ? _timeline is { } t && TeamIndex(t.Players[player].Team) == _mapFocus - TeamFocus
            : player == _mapFocus);

    private float[] FocusTime(MatchTimeline t)
    {
        var sum = new float[MatchTimeline.MapWidth * MatchTimeline.MapHeight];
        foreach (var (player, grid) in t.TimeByCell)
            if (InFocus(player))
                for (var i = 0; i < sum.Length; i++) sum[i] += grid[i];
        return sum;
    }

    // Time in each third of the map, [row, column].
    private static float[,] Zones(float[] grid)
    {
        var z = new float[3, 3];
        for (var i = 0; i < grid.Length; i++)
            z[i / MatchTimeline.MapWidth * 3 / MatchTimeline.MapHeight, i % MatchTimeline.MapWidth * 3 / MatchTimeline.MapWidth] += grid[i];
        return z;
    }

    private static string Across(MapPoint p) => Fmt.Pct(100.0 * p.X / MatchTimeline.MapWidth, 0);
    private static string Down(MapPoint p) => Fmt.Pct(100.0 * p.Y / MatchTimeline.MapHeight, 0);
    private static string Degrees(double? d) => d is { } v ? $"{v:F0}°" : "—";

    // The floor: the map's navmesh, shaded by height, when it lined up with the film; otherwise the
    // squares players went through.
    private static RenderFragment Ground(MatchTimeline t) => __builder =>
    {
        if (t.Floor.Count > 0)
        {
            foreach (var f in t.Floor) { <polygon class="@($"floor floor{f.Level}")" points="@Points(f.Points)" /> }
        }
        else
        {
            foreach (var (x, y) in t.Arena) { <rect class="ground" x="@x" y="@y" width="1" height="1" /> }
        }
    };

    // Clips the heatmap to the floor, so its smoothing doesn't spill past walls.
    private static RenderFragment FloorClip(MatchTimeline t) => __builder =>
    {
        <defs>
            <clipPath id="timeline-floor">
                @foreach (var f in t.Floor) { <polygon points="@Points(f.Points)" /> }
            </clipPath>
        </defs>
    };

    private static string Points(IReadOnlyList<MapPoint> points) => string.Join(' ', points.Select(p => $"{Fmt.Css(p.X)},{Fmt.Css(p.Y)}"));

    // A short line from a point in the direction faced (yaw anticlockwise from +X; the map's Y runs down).
    private static RenderFragment Facing(MapPoint at, double? yaw, int team) => __builder =>
    {
        if (yaw is not { } f) return;
        var r = f * Math.PI / 180;
        <line class="@($"facing stroke{team}")" x1="@Fmt.Css(at.X)" y1="@Fmt.Css(at.Y)" x2="@Fmt.Css(at.X + 3.2 * Math.Cos(r))" y2="@Fmt.Css(at.Y - 3.2 * Math.Sin(r))" />
    };
}
