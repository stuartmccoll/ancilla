@page "/diagnostics"
@inject HaloSession Session
@inject DiagnosticsReport Report
@inject IClipboardWriter Clipboard
@inject IFolderOpener Folders
@inject DiagnosticLog Log

<PageTitle>Diagnostics · Ancilla</PageTitle>

<div class="page-head">
    <div>
        <h1>Diagnostics</h1>
        <p>How the app and Halo's services are doing. Nothing here includes your token, gamertag, player IDs or file paths.</p>
    </div>
    <div class="actions">
        <button @onclick="CopyAsync">Copy diagnostics</button>
        <button class="secondary" @onclick="RefreshAsync">Refresh</button>
    </div>
</div>

<p class="muted" role="status">@_status</p>

@if (_d is null)
{
    <p class="muted">Loading…</p>
}
else
{
    <div class="content">
        <section class="card">
            <h2>This app</h2>
            <dl class="defs">
                <dt>Version</dt><dd>@_d.Version</dd>
                <dt>System</dt><dd>@_d.Os</dd>
                <dt>Runtime</dt><dd>@_d.Runtime</dd>
                <dt>Requests</dt><dd>@_d.InFlight running, @_d.Queued waiting (at most 8 run at once)</dd>
            </dl>
        </section>

        <section class="card" aria-labelledby="errors-h">
            <h2 id="errors-h">Recent errors</h2>
            @if (_d.Errors.Count == 0)
            {
                <p class="muted">No errors in the log files. They cover the last week.</p>
            }
            else
            {
                <p>
                    The newest @_d.Errors.Count.ToString() from the log files, newest first. <em>Copy diagnostics</em>
                    includes the latest @DiagnosticsReport.ErrorsCopied.ToString(), with where in the app they happened.
                </p>
                <ul class="errors">
                    @foreach (var e in _d.Errors)
                    {
                        <li>
                            <details>
                                <summary><time datetime="@e.At.ToString("o")">@e.At.ToLocalTime().ToString("d MMM, HH:mm:ss")</time> @e.Message</summary>
                                @if (e.Detail.Count > 0)
                                {
                                    <pre class="trace" tabindex="0" aria-label="Error details">@string.Join("\n", e.Detail)</pre>
                                }
                            </details>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="card">
            <h2>Halo services</h2>
            @if (_d.Endpoints.Count == 0)
            {
                <p class="muted">No calls yet.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <caption class="visually-hidden">Calls to each Halo service since the app started</caption>
                        <thead><tr><th scope="col">Service</th><th scope="col">Calls</th><th scope="col">Errors</th><th scope="col">Last status</th><th scope="col">Last call took</th></tr></thead>
                        <tbody>
                            @foreach (var e in _d.Endpoints)
                            {
                                <tr>
                                    <th scope="row">@e.Endpoint</th>
                                    <td>@e.Calls</td>
                                    <td>@e.Errors</td>
                                    <td>@(e.LastStatus?.ToString() ?? "no response")</td>
                                    <td>@e.LastMilliseconds.ToString("0") ms</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="card">
            <h2>Stored data</h2>
            <dl class="defs">
                <dt>Shared data (in memory)</dt><dd>@_d.SharedEntries entries</dd>
                <dt>Images (in memory)</dt><dd>@_d.Images, @DiagnosticsReport.Size(_d.ImageBytes)</dd>
                <dt>Match archive</dt><dd>@_d.ArchivedMatches.ToString("N0") matches, @_d.Snapshots progress snapshots, @DiagnosticsReport.Size(_d.ArchiveBytes)</dd>
                <dt>Theater films</dt><dd>@_d.Films, @DiagnosticsReport.Size(_d.FilmBytes)</dd>
                <dt>Log files</dt><dd>@DiagnosticsReport.Size(_d.LogBytes) in <code class="path">@_d.LogFolder</code></dd>
            </dl>
            @if (Folders.IsAvailable)
            {
                <div class="actions folder">
                    <button class="secondary" @onclick="OpenLogsAsync">Open log folder</button>
                </div>
            }
        </section>

        <section class="card">
            <h2>Reporting a problem</h2>
            <p>
                Choose <em>Copy diagnostics</em>, then paste it into a
                <a href="@DiagnosticsReport.BugTemplateUrl" target="_blank" rel="noopener noreferrer">new bug report</a>.
                The copy is redacted the same way as the log files.
            </p>
        </section>
    </div>
}

@code {
    private DiagnosticsSnapshot? _d;
    private string _status = "";

    protected override async Task OnInitializedAsync() => _d = await Report.TakeAsync(Session);

    private async Task RefreshAsync()
    {
        _d = await Report.TakeAsync(Session);
        _status = "Refreshed.";
    }

    private async Task OpenLogsAsync() =>
        _status = await Folders.OpenAsync(Log.Folder) ? "" : "Couldn't open the log folder.";

    private async Task CopyAsync()
    {
        _d = await Report.TakeAsync(Session);
        try
        {
            await Clipboard.SetTextAsync(Report.ToText(_d));
            _status = "Copied. Paste it into your bug report.";
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or NotSupportedException)
        {
            _status = "Couldn't copy to the clipboard.";
        }
    }
}
