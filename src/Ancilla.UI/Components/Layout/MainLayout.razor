@inherits LayoutComponentBase
@implements IDisposable
@inject HaloSession Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IThemePreference ThemePreference

<header class="appbar">
    <div class="appbar-inner">
        <a class="brand" href="" aria-label="Ancilla home"><Logo /></a>
        @if (Session.IsSignedIn)
        {
            <nav class="sections" aria-label="Sections">
                @foreach (var s in Sections)
                {
                    <a href="@s.Href" class="@(s == _section ? "active" : "")" aria-current="@(s == _section ? "page" : null)">@s.Label</a>
                }
            </nav>
            <div class="user">
                <button class="user-btn" aria-expanded="@(_menuOpen ? "true" : "false")" aria-controls="user-menu"
                        @onclick="() => _menuOpen = !_menuOpen" title="@Session.Me!.Gamertag">
                    @if (Session.Me!.Gamerpic?.Small is { } pic)
                    {
                        <img src="@pic" alt="" width="30" height="30" />
                    }
                    <span class="gt">@Session.Me.Gamertag</span>
                    <svg class="chev" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
                @if (_menuOpen)
                {
                    @* Transparent backdrop catches outside clicks without any JavaScript. *@
                    <button class="backdrop" aria-label="Close menu" tabindex="-1" @onclick="() => _menuOpen = false"></button>
                    <div id="user-menu" class="menu" @onkeydown="OnMenuKey">
                        <div class="menu-head">
                            <span class="menu-gt">@Session.Me.Gamertag</span>
                            @if (!string.IsNullOrEmpty(Session.ServiceTag))
                            {
                                <span class="stag">@Session.ServiceTag</span>
                            }
                        </div>
                        @if (Session.FromEnvironment)
                        {
                            <p class="menu-note">Signed in with HALO_SPARTAN_TOKEN. Signing out lasts until the page is reloaded.</p>
                        }
                        <div class="menu-section" role="radiogroup" aria-label="Theme">
                            <span class="menu-label">Theme</span>
                            @foreach (var t in Themes.All)
                            {
                                var on = t.Id == _theme;
                                <button class="theme-opt @(on ? "on" : "")" role="radio" aria-checked="@(on ? "true" : "false")"
                                        title="@t.Description" @onclick="() => SetThemeAsync(t.Id)">
                                    <span class="swatch" aria-hidden="true">
                                        @foreach (var c in t.Swatches) { <span style="background:@c"></span> }
                                    </span>
                                    <span class="theme-name">@t.Name</span>
                                    @if (on)
                                    {
                                        <svg class="check" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2.5 7.5 5.5 10.5 11.5 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                    }
                                </button>
                            }
                        </div>
                        <a class="menu-item" href="settings">Settings</a>
                        <a class="menu-item" href="diagnostics">Diagnostics</a>
                        <button class="menu-item" @onclick="SignOut">Sign out</button>
                    </div>
                }
            </div>
        }
    </div>
    @if (Session.IsSignedIn && _section?.Tabs is { Length: > 1 } tabs)
    {
        <div class="subbar">
            <nav class="tabs" aria-label="@_section.Label">
                @foreach (var t in tabs)
                {
                    var on = t.IsActive(_path);
                    <a href="@t.Href" class="@(on ? "active" : "")" aria-current="@(on ? "page" : null)">@t.Label</a>
                }
            </nav>
        </div>
    }
</header>

<main>
    @if (_starting)
    {
        <p class="muted">Signing in…</p>
    }
    else if (!Session.IsSignedIn)
    {
        <SignIn InitialError="@_envError" />
    }
    else
    {
        @Body
    }
</main>

<footer class="site-footer">
    <div class="footer-inner">
        <p>
            <strong>Ancilla</strong> is an unofficial fan project. Not affiliated with, endorsed or sponsored by
            Microsoft, Xbox or Halo Studios. Halo and Xbox are trademarks of Microsoft Corporation.
        </p>
        <p class="footer-links">
            <a href="about">About</a>
            <a href="about#privacy">Privacy</a>
            <a href="settings">Settings</a>
            <a href="diagnostics">Diagnostics</a>
            <span>Data from Halo Waypoint services</span>
        </p>
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private sealed record Tab(string Label, string Href, Func<string, bool> IsActive);
    private sealed record Section(string Label, string Href, Func<string, bool> Owns, Tab[] Tabs);

    private static bool Is(string path, params string[] options) => options.Contains(path);
    private static bool Under(string path, string root) => path == root || path.StartsWith(root + "/");

    // Pages grouped by what they're about. Old flat URLs (/medals, /trends, /insights, /players) still work.
    private static readonly Section[] Sections =
    [
        new("Home", "", p => p == "", []),
        new("Progress", "progress", p => p == "progress", []),
        new("Stats", "stats", p => Under(p, "stats") || p == "medals",
        [
            new("Service record", "stats", p => p == "stats"),
            new("Medals", "stats/medals", p => Is(p, "stats/medals", "medals")),
        ]),
        new("Matches", "matches", p => Under(p, "matches") || Is(p, "trends", "insights") || Under(p, "players"),
        [
            // Match detail pages (/matches/{id}) count as History.
            new("History", "matches", p => Under(p, "matches") && !Is(p, "matches/trends", "matches/insights") && !Under(p, "matches/players")),
            new("Trends", "matches/trends", p => Is(p, "matches/trends", "trends")),
            new("Insights", "matches/insights", p => Is(p, "matches/insights", "insights")),
            new("Players", "matches/players", p => Under(p, "matches/players") || Under(p, "players")),
        ]),
        new("About", "about", p => p == "about", []),
    ];

    private bool _starting = true;
    private string? _envError;
    private bool _menuOpen;
    private string _path = "";
    private Section? _section;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
        UpdateLocation();
        if (!Session.IsSignedIn)
        {
            try { await Session.TrySignInFromEnvironmentAsync(); }
            catch (Exception ex) { _envError = $"HALO_SPARTAN_TOKEN didn't work: {SignIn.Explain(ex)}"; }
        }
        _starting = false;
    }

    private void UpdateLocation()
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri);
        _path = rel.Split('?', '#')[0].Trim('/').ToLowerInvariant();
        _section = Sections.FirstOrDefault(s => s.Owns(_path));
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateLocation();
        _menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private string _theme = Themes.Default.Id;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            // The desktop shell remembers the theme itself; the web host's page shell already shows the cookie's.
            if (ThemePreference.Saved is { } saved)
            {
                _theme = Themes.Normalize(saved);
                await JS.InvokeVoidAsync("haloTheme.set", _theme);
            }
            else _theme = Themes.Normalize(await JS.InvokeAsync<string>("haloTheme.get"));
            StateHasChanged();
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }   // no JS (e.g. static rendering)
    }

    private async Task SetThemeAsync(string id)
    {
        _theme = Themes.Normalize(id);
        ThemePreference.Save(_theme);
        try { await JS.InvokeVoidAsync("haloTheme.set", _theme); }
        catch (JSException) { }
    }

    private void OnMenuKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _menuOpen = false;
    }

    private void SignOut()
    {
        _menuOpen = false;
        Session.SignOut();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
