<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Ancilla.Theater.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Ancilla.Core/Ancilla.Core.csproj" />
    <ProjectReference Include="../Ancilla.Theater/Ancilla.Theater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The API fixtures, the last known shape of each response, for the drift command. -->
    <Content Include="../../tests/Ancilla.Testing/Fixtures/*.json" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
