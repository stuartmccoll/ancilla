@page "/matches/{MatchId}"
@inject HaloSession Session

<PageTitle>@(_mode?.PublicName ?? "Match") · Ancilla</PageTitle>

<p class="back"><a href="matches">&larr; Matches</a></p>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}
else if (_match is not { } m)
{
    <p class="muted">Loading match…</p>
}
else
{
    var info = m.MatchInfo;
    var me = m.Players.FirstOrDefault(p => p.Xuid == Session.Xuid);
    var mine = me?.Stats?.CoreStats;

    <header class="hero" style="@(_map?.HeroUrl is { } hero ? $"background-image:url('{hero}')" : "")">
        <div class="hero-inner">
            <div class="hero-top">
                @if (me is not null)
                {
                    <span class="badge @Fmt.OutcomeClass(me.Outcome)">@Fmt.Outcome(me.Outcome)</span>
                }
                @if (HaloSession.ScoreLine(m, me) is { } score)
                {
                    <span class="hero-score">@score</span>
                }
            </div>
            <h1>@(_mode?.PublicName ?? "Match")</h1>
            <p>
                @(_map?.PublicName ?? "Unknown map")
                @if (_playlist?.PublicName is { } pl) { <span> · @pl</span> }
            </p>
            <p class="hero-when">@Fmt.When(info.StartTime) · @Fmt.Duration(info.Duration)</p>
        </div>
    </header>

    @if (mine is not null)
    {
        <section class="tiles">
            <div class="tile"><span class="label">K / D / A</span><span class="value">@mine.Kills / @mine.Deaths / @mine.Assists</span></div>
            <div class="tile"><span class="label">KDA</span><span class="value">@((mine.KDA ?? 0).ToString("+0.##;-0.##;0"))</span></div>
            <div class="tile"><span class="label">Accuracy</span><span class="value">@Fmt.Pct(mine.Accuracy)</span>
                <span class="note">@Fmt.N(mine.ShotsHit) / @Fmt.N(mine.ShotsFired) shots</span></div>
            <div class="tile"><span class="label">Damage</span><span class="value">@Fmt.N(mine.DamageDealt)</span>
                <span class="note">@Fmt.N(mine.DamageTaken) taken</span></div>
            <div class="tile"><span class="label">Personal score</span><span class="value">@Fmt.N(mine.PersonalScore)</span>
                @if (!info.TeamsEnabled && me!.Rank > 0) { <span class="note">@Fmt.Ordinal(me.Rank) place</span> }</div>
            <div class="tile"><span class="label">Avg life</span><span class="value">@Fmt.Duration(mine.AverageLifeDuration)</span>
                <span class="note">Best spree @mine.MaxKillingSpree</span></div>
        </section>
    }

    @if (_skill is { } sk && (sk.StatPerformances is { Count: > 0 } || IsRankedMatch(sk)))
    {
        <section class="card">
            <h2>Against expectations</h2>
            <div class="perf">
                @foreach (var (stat, perf) in sk.StatPerformances ?? [])
                {
                    var delta = perf.Count - perf.Expected;
                    var good = stat == "Deaths" ? delta <= 0 : delta >= 0;
                    <div class="perf-item">
                        <span class="label">@stat</span>
                        <span class="perf-val">@Fmt.N(perf.Count)</span>
                        <span class="muted">expected @perf.Expected.ToString("F1")
                            <span class="@(good ? "pos" : "neg")">(@delta.ToString("+0.0;-0.0;0"))</span></span>
                    </div>
                }
                @if (sk.TeamMmrs is { Count: > 1 } mmrs)
                {
                    <div class="perf-item">
                        <span class="label">Team MMR</span>
                        <span class="perf-val">@string.Join(" vs ", mmrs.OrderBy(t => t.Key == sk.TeamId.ToString() ? 0 : 1).Select(t => t.Value.ToString("N0")))</span>
                        <span class="muted">your team first</span>
                    </div>
                }
                @if (IsRankedMatch(sk))
                {
                    var pre = sk.RankRecap!.PreMatchCsr!;
                    var post = sk.RankRecap.PostMatchCsr!;
                    var change = post.Value - pre.Value;
                    <div class="perf-item">
                        <span class="label">CSR</span>
                        <span class="perf-val">@post.Display</span>
                        <span class="muted">@Fmt.N(pre.Value) &rarr; @Fmt.N(post.Value)
                            <span class="@(change >= 0 ? "pos" : "neg")">(@change.ToString("+0;-0;0"))</span></span>
                    </div>
                }
            </div>
            <p class="hint">"Expected" is what the matchmaker predicted for a player of your skill in this lobby.</p>
        </section>
    }

    @if (_book is not null && mine is { Medals.Count: > 0 })
    {
        <section class="card">
            <h2>Your medals</h2>
            <div class="medals">
                @foreach (var md in mine.Medals.OrderByDescending(x => _book.ById.GetValueOrDefault(x.NameId)?.DifficultyIndex ?? 0).ThenByDescending(x => x.Count))
                {
                    <div class="medal-item">
                        <MedalIcon Book="_book" NameId="md.NameId" Size="56" Count="md.Count" />
                        <span>@(_book.ById.GetValueOrDefault(md.NameId)?.Name)</span>
                    </div>
                }
            </div>
        </section>
    }

    <section class="card timeline-link">
        <h2>Timeline</h2>
        <p>Who killed whom and when, the medals each kill earned, team kills minute by minute and where players died, from the match's Theater film.</p>
        <p><a href="@($"matches/{MatchId}/timeline")">Open the timeline &rarr;</a></p>
    </section>

    <h2 class="section-title">Scoreboard</h2>
    @foreach (var group in Teams(m))
    {
        <section class="card team">
            <div class="team-head">
                <span class="team-name">@group.Name</span>
                @if (group.Team is { } t)
                {
                    <span class="badge @Fmt.OutcomeClass(t.Outcome)">@Fmt.Outcome(t.Outcome)</span>
                    <span class="team-score">@Fmt.N(t.Stats.CoreStats.Score)</span>
                }
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th class="player">Player</th>
                            <th>Score</th><th>K</th><th>D</th><th>A</th><th>KDA</th><th>Acc</th><th>Dmg</th><th class="hide-sm">Medals</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in group.Players)
                        {
                            var s = p.Stats?.CoreStats;
                            var user = p.Xuid is { } x ? _users?.GetValueOrDefault(x) : null;
                            <tr class="@(p.Xuid == Session.Xuid ? "me" : "")">
                                <td class="player">
                                    <span class="who">
                                        @if (user?.Gamerpic?.Small is { } pic)
                                        {
                                            <img src="@pic" alt="" width="24" height="24" loading="lazy" />
                                        }
                                        @if (p.Xuid is { } px && px != Session.Xuid)
                                        {
                                            <a class="name" href="matches/players/@px" title="Head-to-head">@(user?.Gamertag ?? "Player")</a>
                                        }
                                        else
                                        {
                                            <span class="name">@(p.IsHuman ? user?.Gamertag ?? "Player" : "Bot")</span>
                                        }
                                        @if (p.ParticipationInfo?.LeftInProgress == true) { <span class="tag dim">Left</span> }
                                        @if (p.ParticipationInfo?.JoinedInProgress == true) { <span class="tag dim">Joined late</span> }
                                    </span>
                                </td>
                                @if (s is not null)
                                {
                                    <td>@Fmt.N(s.PersonalScore)</td>
                                    <td>@s.Kills</td>
                                    <td>@s.Deaths</td>
                                    <td>@s.Assists</td>
                                    <td>@((s.KDA ?? 0).ToString("0.##"))</td>
                                    <td>@Fmt.Pct(s.Accuracy, 0)</td>
                                    <td>@Fmt.N(s.DamageDealt)</td>
                                    <td class="hide-sm">@s.Medals.Sum(x => x.Count)</td>
                                }
                                else
                                {
                                    <td colspan="8" class="muted">No stats</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (me?.Stats is { } myStats)
    {
        <h2 class="section-title">Your mode stats</h2>
        <StatGroups Groups="myStats.ModeStats" ShowEmpty="true" />
    }
}

@code {
    [Parameter] public string MatchId { get; set; } = "";

    private MatchStats? _match;
    private UgcAsset? _map, _mode, _playlist;
    private MatchSkill? _skill;
    private MedalBook? _book;
    private IReadOnlyDictionary<string, UserProfile>? _users;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _match = null; _map = _mode = _playlist = null; _skill = null; _users = null; _error = null;
        if (!HaloIds.IsGuid(MatchId))
        {
            _error = "That isn't a valid match link.";
            return;
        }
        try
        {
            var skill = Session.GetSkillAsync(MatchId);
            var book = Session.GetMedalBookAsync();
            _match = await Session.GetMatchAsync(MatchId);
            var info = _match.MatchInfo;
            var map = Session.GetMapAsync(info.MapVariant);
            var mode = Session.GetModeAsync(info.UgcGameVariant);
            var playlist = Session.GetPlaylistAsync(info.Playlist);
            var users = Session.GetUsersAsync(_match.Players.Select(p => p.Xuid).OfType<string>());
            StateHasChanged();
            (_map, _mode, _playlist) = (await map, await mode, await playlist);
            _users = await users;
            _skill = await skill;
            try { _book = await book; } catch (HttpRequestException) { }
        }
        catch (Exception ex)
        {
            _error = SignIn.Explain(ex);
        }
    }

    private static bool IsRankedMatch(MatchSkill s) =>
        s.RankRecap is { PreMatchCsr: { IsRanked: true }, PostMatchCsr: { IsRanked: true } };

    private sealed record TeamGroup(string Name, MatchTeam? Team, List<MatchPlayer> Players);

    private static IEnumerable<TeamGroup> Teams(MatchStats m)
    {
        // In team modes a player's Rank is their team's placement, so order by personal score.
        // In free-for-all, Rank is the player's own placement.
        static List<MatchPlayer> Order(IEnumerable<MatchPlayer> ps, bool byRank) =>
            ps.OrderBy(p => byRank && p.Rank > 0 ? p.Rank : int.MaxValue)
              .ThenByDescending(p => p.Stats?.CoreStats.PersonalScore ?? 0).ToList();

        if (!m.MatchInfo.TeamsEnabled)
        {
            yield return new TeamGroup("Players", null, Order(m.Players, byRank: true));
            yield break;
        }
        foreach (var t in m.Teams.OrderBy(t => t.Rank).ThenBy(t => t.TeamId))
        {
            var players = Order(m.Players.Where(p => p.LastTeamId == t.TeamId), byRank: false);
            if (players.Count > 0) yield return new TeamGroup(Fmt.TeamName(t.TeamId), t, players);
        }
    }
}
