@page "/settings"
@implements IDisposable
@inject HaloSession Session
@inject IJSRuntime JS

<PageTitle>Settings · Ancilla</PageTitle>

<div class="page-head">
    <div>
        <h1>Settings</h1>
        <p>The data Ancilla keeps on this machine: your match archive and downloaded films.</p>
    </div>
</div>

<p class="muted" role="status">@_status</p>

<div class="content">
    <section class="card" aria-labelledby="archive-h">
        <h2 id="archive-h">Match archive</h2>
        <p>
            Every match you load is kept in a database on this machine, so Trends, Insights and Players can cover more
            than the API's recent history, and what you've already loaded shows straight away after a restart.
            See <a href="about#privacy">About</a> for what's stored.
        </p>
        <dl class="defs">
            <dt>Matches stored</dt><dd>@_summary.Matches.ToString("N0")</dd>
            <dt>With a scoreboard</dt><dd>@_summary.WithScoreboard.ToString("N0")</dd>
            <dt>With a skill result</dt><dd>@_summary.WithSkill.ToString("N0")</dd>
            <dt>Oldest</dt><dd>@(_summary.Oldest is { } o ? o.ToLocalTime().ToString("d MMM yyyy") : "none yet")</dd>
            <dt>Newest</dt><dd>@(_summary.Newest is { } n ? n.ToLocalTime().ToString("d MMM yyyy") : "none yet")</dd>
            <dt>Size on disk</dt><dd>@DiagnosticsReport.Size(_summary.SizeBytes)</dd>
            <dt>Location</dt><dd><code class="path">@Session.ArchiveFile</code></dd>
        </dl>
        <div class="actions">
            <button @onclick="BackfillAsync" disabled="@_busy">@(_busy ? "Loading…" : "Load older matches")</button>
            <button class="secondary" @onclick='() => ExportAsync("csv")' disabled="@_busy">Export as CSV</button>
            <button class="secondary" @onclick='() => ExportAsync("json")' disabled="@_busy">Export as JSON</button>
        </div>
        <p class="muted">
            Loading older matches asks Halo's services for your whole history, 25 at a time, then for each match
            you don't have yet. It can take a while for a long history, and it picks up where it left off if you stop.
            The exports have one row per match, without other players' names or IDs.
        </p>
    </section>

    <section class="card" aria-labelledby="films-h">
        <h2 id="films-h">Theater films</h2>
        <p>
            Films are downloaded when you load a match's timeline, and cached so they needn't be downloaded again.
            When the cache goes over @DiagnosticsReport.Size(Session.FilmLimitBytes), the films fetched longest ago are deleted.
            Set <code>FilmCacheLimitMb</code> to change that.
        </p>
        <dl class="defs">
            <dt>Cached films</dt><dd>@DiagnosticsReport.Size(_filmBytes)</dd>
            <dt>Location</dt><dd><code class="path">@Session.FilmFolder</code></dd>
        </dl>
        <div class="actions">
            <button class="secondary" @onclick="ClearFilms" disabled="@(_filmBytes == 0)">Clear films</button>
        </div>
    </section>
</div>

@code {
    private ArchiveSummary _summary = null!;
    private long _filmBytes;
    private string? _status;
    private bool _busy;
    private CancellationTokenSource? _cts;

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        _summary = Session.ArchiveSummary();
        _filmBytes = Session.FilmBytes();
    }

    private async Task BackfillAsync()
    {
        _busy = true;
        _cts = new CancellationTokenSource();
        _status = "Looking for older matches…";
        try
        {
            var result = await Session.BackfillAsync(msg =>
            {
                _status = msg;
                _ = InvokeAsync(StateHasChanged);
            }, _cts.Token);
            _status = result.Added == 0
                ? $"Nothing new to load. {result.Matches:N0} matches are stored."
                : $"Added {result.Added:N0} matches. {result.Matches:N0} are stored.";
        }
        catch (OperationCanceledException) { _status = "Stopped. What's loaded so far is kept."; }
        catch (HttpRequestException ex) { _status = $"Couldn't finish: {ex.Message}"; }
        finally
        {
            _busy = false;
            Reload();
        }
    }

    private async Task ExportAsync(string format)
    {
        var rows = Session.ExportRows();
        var text = format == "csv" ? ArchiveExport.ToCsv(rows) : ArchiveExport.ToJson(rows);
        var mime = format == "csv" ? "text/csv" : "application/json";
        try
        {
            await JS.InvokeVoidAsync("ancillaDownload", $"ancilla-matches.{format}", mime, text);
            _status = $"Exported {rows.Count:N0} matches.";
        }
        catch (JSException) { _status = "Couldn't start the download."; }
    }

    private void ClearFilms()
    {
        var n = Session.ClearFilms();
        _status = $"Deleted {n} {(n == 1 ? "film" : "films")}.";
        Reload();
    }

    public void Dispose() => _cts?.Cancel();
}
