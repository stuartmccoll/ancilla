@page "/"
@implements IDisposable
@inject HaloSession Session
@inject SnapshotStore Snapshots

<PageTitle>Ancilla</PageTitle>

@* ---- Profile header ---- *@
<header class="profile">
    @if (Session.Me?.Gamerpic?.Medium is { } pic)
    {
        <img class="gamerpic" src="@pic" alt="" width="72" height="72" />
    }
    <div class="who">
        <h1>
            @Session.Me?.Gamertag
            @if (!string.IsNullOrEmpty(Session.ServiceTag)) { <span class="stag">@Session.ServiceTag</span> }
        </h1>
        <p class="muted">
            @if (Session.Report is { } r)
            {
                <span>@r.Career.NextRankTitle</span>
            }
            @if (_sr is { } sr)
            {
                <span> · @Fmt.N(sr.MatchesCompleted) matchmade games · @Fmt.Duration(sr.TimePlayed) played</span>
            }
        </p>
    </div>
    @if (_rankIcon is not null)
    {
        <img class="rank" src="@_rankIcon" alt="@Session.Report?.Career.NextRankTitle" />
    }
</header>

<div class="grid">
    @* ---- Progress ---- *@
    <section class="card ov">
        <div class="ov-head"><h2>Progress</h2><a href="progress">Progress &rarr;</a></div>
        @if (Session.Report is { } rep)
        {
            var c = rep.Career;
            var pct = c.XpTotal == 0 ? 0 : 100.0 * c.XpEarned / c.XpTotal;
            <div class="meter">
                <div class="meter-label"><span>Career · @c.NextRankTitle</span><span>@Fmt.Pct(pct)</span></div>
                <div class="bar small" role="progressbar" aria-label="Career progress" aria-valuenow="@pct.ToString("F0")" aria-valuemin="0" aria-valuemax="100"><div class="fill" style="width:@Fmt.Css(pct)%"></div></div>
                <div class="meter-note">@(c.IsHero ? "Hero reached" : $"~{Fmt.N(rep.GamesFor(c.XpRemaining))} games to Hero")</div>
            </div>
            @if (rep.Passes.FirstOrDefault(p => p.IsActive && !p.IsComplete) is { } pass)
            {
                var pp = pass.XpTotal == 0 ? 0 : 100.0 * pass.XpEarned / pass.XpTotal;
                <div class="meter">
                    <div class="meter-label"><span>Active pass · @pass.Name</span><span>@pass.RanksCompleted / @pass.TotalRanks</span></div>
                    <div class="bar small" role="progressbar" aria-label="Active pass progress" aria-valuenow="@pp.ToString("F0")" aria-valuemin="0" aria-valuemax="100"><div class="fill" style="width:@Fmt.Css(pp)%"></div></div>
                    <div class="meter-note">@(rep.PassGamesFor(pass.XpRemaining) is { } n ? $"~{Fmt.N(n)} games to finish" : "Games to finish: still measuring pass XP per game")</div>
                </div>
            }
            var left = rep.RemainingPasses(false).Count();
            <p class="hint">@(left == 0 ? "Every pass you own is finished." : $"{left} unfinished {(left == 1 ? "pass" : "passes")} you own" + (rep.PassEstimate is { } pe ? $" · ~{Fmt.N(pe.XpPerMatch)} pass XP per game" : ""))</p>
        }
        else if (_progressError is not null) { <p class="error">@_progressError</p> }
        else { <Skeleton Lines="3" /> }
    </section>

    @* ---- Stats ---- *@
    <section class="card ov">
        <div class="ov-head"><h2>Stats</h2><span class="links"><a href="stats">Service record &rarr;</a><a href="stats/medals">Medals &rarr;</a></span></div>
        @if (_sr is { } s)
        {
            var cs = s.CoreStats;
            <div class="mini">
                <div><span class="label">Win rate</span><span class="value">@Fmt.Pct(s.MatchesCompleted == 0 ? 0 : 100.0 * s.Wins / s.MatchesCompleted, 0)</span></div>
                <div><span class="label">K/D</span><span class="value">@cs.KillDeathRatio.ToString("F2")</span></div>
                <div><span class="label">Accuracy</span><span class="value">@Fmt.Pct(cs.Accuracy, 0)</span></div>
                <div><span class="label">Kills</span><span class="value">@Fmt.N(cs.Kills)</span></div>
            </div>
            @if (_book is not null && cs.Medals.Count > 0)
            {
                <div class="medals" aria-label="Most earned medals">
                    @foreach (var m in cs.Medals.OrderByDescending(m => m.Count).Take(5))
                    {
                        <div class="medal">
                            <MedalIcon Book="_book" NameId="m.NameId" Size="44" />
                            <span class="mcount">@Fmt.N(m.Count)</span>
                        </div>
                    }
                </div>
                <p class="hint">Your most earned medals.</p>
            }
        }
        else if (_statsError is not null) { <p class="error">@_statsError</p> }
        else { <Skeleton Lines="3" /> }
    </section>

    @* ---- Matches ---- *@
    <section class="card ov">
        <div class="ov-head"><h2>Matches</h2><span class="links"><a href="matches">History &rarr;</a><a href="matches/trends">Trends &rarr;</a><a href="matches/insights">Insights &rarr;</a></span></div>
        @if (_recent is { } recent)
        {
            var form = recent.Take(10).Reverse().ToList();   // oldest → newest, left to right
            var me = Session.Xuid;
            <div class="form-row">
                <span class="label">Last @form.Count</span>
                <div class="form" role="list" aria-label="Results of your last @form.Count matches, oldest first">
                    @foreach (var m in form)
                    {
                        var o = m.Entry.Outcome;
                        <a role="listitem" class="res @Fmt.OutcomeClass(o)" href="matches/@m.Entry.MatchId"
                           title="@($"{Fmt.Outcome(o)} · {Fmt.When(m.Entry.MatchInfo.StartTime)}")">@Fmt.Outcome(o)[0]</a>
                    }
                </div>
                <span class="muted rec">@form.Count(m => m.Entry.Outcome == MatchOutcome.Win)W @form.Count(m => m.Entry.Outcome != MatchOutcome.Win)L</span>
            </div>

            var pvp = recent.Where(m => !m.IsPve(me)).Reverse()
                .Select(m => m.Stats.Players.FirstOrDefault(p => p.Xuid == me)?.Stats?.CoreStats).OfType<CoreStats>().ToList();
            @if (pvp.Count >= 3)
            {
                var kds = pvp.Select(x => x.Deaths == 0 ? (double)x.Kills : (double)x.Kills / x.Deaths).ToList();
                var overall = Companion.Kd(pvp);
                <div class="spark-row">
                    <div class="spark-num"><span class="value">@overall.ToString("F2")</span><span class="label">K/D, last @pvp.Count PvP games</span></div>
                    <Sparkline Values="kds" Ref="1" Label="@($"K/D per game over your last {pvp.Count} PvP games, from {kds.Min():F2} to {kds.Max():F2}")" />
                </div>
            }

            <ul class="recent">
                @foreach (var m in recent.Take(3))
                {
                    var mine = m.Stats.Players.FirstOrDefault(p => p.Xuid == me)?.Stats?.CoreStats;
                    <li>
                        <a href="matches/@m.Entry.MatchId">
                            <span class="badge @Fmt.OutcomeClass(m.Entry.Outcome)">@Fmt.Outcome(m.Entry.Outcome)</span>
                            <span class="r-main">
                                <span class="r-title">@(_modeNames.GetValueOrDefault(m.Entry.MatchId) ?? "Match")</span>
                                <span class="muted">@Fmt.Ago(m.Entry.MatchInfo.StartTime)</span>
                            </span>
                            <span class="r-kda">@(mine is null ? "" : $"{mine.Kills}/{mine.Deaths}/{mine.Assists}")</span>
                        </a>
                    </li>
                }
            </ul>
        }
        else if (_matchesError is not null) { <p class="error">@_matchesError</p> }
        else { <Skeleton Lines="4" /> }
    </section>

    @* ---- Players ---- *@
    <section class="card ov">
        <div class="ov-head"><h2>Players</h2><a href="matches/players">Players &rarr;</a></div>
        @if (_companions is { } comps)
        {
            @if (comps.Count == 0)
            {
                <p class="muted">Nobody has shown up more than once in your last @(_recent?.Count ?? 0) games.</p>
            }
            else
            {
                <p class="hint top">Seen most in your last @(_recent?.Count ?? 0) games</p>
                <ul class="people">
                    @foreach (var c in comps)
                    {
                        var u = _users?.GetValueOrDefault(c.Xuid);
                        <li>
                            <a href="matches/players/@c.Xuid">
                                @if (u?.Gamerpic?.Small is { } p) { <img src="@p" alt="" width="32" height="32" loading="lazy" /> }
                                else { <span class="nopic"></span> }
                                <span class="p-main">
                                    <span class="p-name">@(u?.Gamertag ?? "Player")</span>
                                    <span class="muted">@c.Games games · with @Record(c.WithWins, c.WithGames) · against @Record(c.AgainstWins, c.AgainstGames)</span>
                                </span>
                            </a>
                        </li>
                    }
                </ul>
            }
        }
        else if (_matchesError is not null) { <p class="error">@_matchesError</p> }
        else { <Skeleton Lines="3" /> }
    </section>
</div>

@code {
    private const int RecentCount = 25;

    private ServiceRecord? _sr;
    private MedalBook? _book;
    private string? _rankIcon;
    private IReadOnlyList<RecentMatch>? _recent;
    private List<Companion>? _companions;
    private IReadOnlyDictionary<string, UserProfile>? _users;
    private readonly Dictionary<string, string> _modeNames = [];
    private string? _progressError, _statsError, _matchesError;
    private bool _disposed;

    // Each card loads independently, so one slow or failing call doesn't hold up the rest.
    protected override Task OnInitializedAsync() => Task.WhenAll(
        Run(LoadProgressAsync, e => _progressError = e),
        Run(LoadStatsAsync, e => _statsError = e),
        Run(LoadMatchesAsync, e => _matchesError = e));

    private async Task Run(Func<Task> load, Action<string> onError)
    {
        try { await load(); }
        catch (Exception ex) { onError(SignIn.Explain(ex)); }
        if (!_disposed) StateHasChanged();
    }

    private async Task LoadProgressAsync()
    {
        // Same report the Progress page shows; building it also saves a forecast snapshot.
        Session.Report ??= await new ProgressService(Session.Client, Snapshots).BuildReportAsync(Session.XpAverage, Session.XpOverride);
        Refresh();
        _rankIcon = await Session.GetCmsImageUrlAsync(Session.Report.Career.RankIcon);
    }

    private async Task LoadStatsAsync()
    {
        _sr = await Session.GetServiceRecordAsync();
        Refresh();
        try { _book = await Session.GetMedalBookAsync(); } catch (HttpRequestException) { }
    }

    private async Task LoadMatchesAsync()
    {
        _recent = await Session.GetRecentMatchesAsync(MatchHistoryType.Matchmaking, RecentCount);
        _companions = Companion.FromMatches(_recent, Session.Xuid).Values
            .Where(c => c.Games >= 2).OrderByDescending(c => c.Games).ThenByDescending(c => c.LastPlayed).Take(4).ToList();
        Refresh();
        foreach (var m in _recent.Take(3))
        {
            var info = m.Entry.MatchInfo;
            var mode = await Session.GetModeAsync(info.UgcGameVariant);
            var map = await Session.GetMapAsync(info.MapVariant);
            _modeNames[m.Entry.MatchId] = $"{mode?.PublicName ?? "Unknown mode"} on {map?.PublicName ?? "unknown map"}";
        }
        Refresh();
        _users = await Session.GetUsersAsync(_companions.Select(c => c.Xuid));
    }

    private void Refresh() { if (!_disposed) StateHasChanged(); }

    private static string Record(int wins, int games) => games == 0 ? "—" : $"{wins}–{games - wins}";

    public void Dispose() => _disposed = true;
}
