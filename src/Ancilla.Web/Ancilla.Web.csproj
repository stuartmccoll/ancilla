<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The web dev host: Ancilla.UI served with interactive server rendering on localhost, for
    development with hot reload and for the browser tests. The desktop app is src/Ancilla.App.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Ancilla.UI\Ancilla.UI.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

</Project>
