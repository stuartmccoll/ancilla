<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The desktop app: a .NET MAUI Blazor Hybrid shell that shows Ancilla.UI in a native window on
    Windows (WinUI) and macOS (Mac Catalyst). It needs the MAUI workload, so it isn't in Ancilla.sln:
    build it on its own (see the README's Run section). Each OS builds only its own target.
  -->
  <PropertyGroup>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-maccatalyst</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Ancilla.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Blazor handles the CSS, not MAUI. -->
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>

    <ApplicationTitle>Ancilla</ApplicationTitle>
    <ApplicationId>app.ancilla.desktop</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Unpackaged on Windows, so `dotnet run` works. Signed installers are N9 (#22). -->
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copied from branding/favicon-suite. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#F4F8FB" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F4F8FB" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ancilla.UI\Ancilla.UI.csproj" />
  </ItemGroup>

</Project>
