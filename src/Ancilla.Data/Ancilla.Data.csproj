<Project Sdk="Microsoft.NET.Sdk">

  <!-- The local SQLite archive of matches, skill results, UGC names and progress snapshots. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Ancilla.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <!-- Newer than the one Microsoft.Data.Sqlite pulls in, which has a known vulnerability. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ancilla.Core\Ancilla.Core.csproj" />
  </ItemGroup>

</Project>
